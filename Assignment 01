#include <stdio.h>

int main() {
    int year, month, days;

    scanf("%d%d", &year, &month);

    if (year < 1900 || year > 9999) {
        printf("0");
        return 0;
    }

    switch (month) {
        case 1: case 3: case 5: case 7:
        case 8: case 10: case 12:
            days = 31;
            break;

        case 4: case 6: case 9: case 11:
            days = 30;
            break;

        case 2:
            if ((year % 400 == 0) ||
                (year % 4 == 0 && year % 100 != 0))
                days = 29;
            else
                days = 28;
            break;

        default:
            printf("0");
            return 0;
    }

    printf("%d Days", days);

    return 0;
}



