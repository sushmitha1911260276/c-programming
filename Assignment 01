#include <stdio.h>

int main() {
    int coins, x, y;
    int ben, blackbeard, pirates;

    scanf("%d%d%d", &coins, &x, &y);

    ben = coins * x / 100;
    coins = coins - ben;

    blackbeard = coins * y / 100;
    coins = coins - blackbeard;

    pirates = coins / 3;

    printf("%d\n%d\n%d\n", ben, blackbeard, pirates);

    return 0;
}


